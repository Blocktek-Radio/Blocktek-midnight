{
  "name": "blocktek-radio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "dev": "next dev",
    "dev:api": "pnpm --filter @blocktek/api dev",
    "build": "next build",
    "build:api": "pnpm --filter @blocktek/api build",
    "build:worker": "pnpm --filter @blocktek/worker build",
    "db:migrate": "pnpm --filter @blocktek/api db:migrate",
    "start": "next start",
    "start:api": "pnpm --filter @blocktek/api start",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "midnight:compile": "compact compile contracts/midnight/contributor-eligibility.compact packages/midnight/managed"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@blocktek/ai": "workspace:*",
    "@blocktek/midnight": "workspace:*",
    "@blocktek/radio-core": "workspace:*",
    "@blocktek/types": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@vercel/analytics": "1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.6.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "^19",
    "react-dom": "^19",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.12.25",
      "@midnight-ntwrk/ledger-v8": "8.1.0",
      "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
      "@midnight-ntwrk/wallet-sdk": "1.2.0"
    }
  }
}
