# Public web configuration. This value is safe to expose to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Production Compose binds web/API to loopback ports for Nginx.
BLOCKTEK_WEB_BIND_PORT=3010
BLOCKTEK_API_BIND_PORT=4010

# API runtime configuration. Never prefix server secrets with NEXT_PUBLIC_.
API_HOST=0.0.0.0
API_PORT=4000
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# Persistence is optional for host development and required by the production-shaped API container.
POSTGRES_DB=blocktek_radio
POSTGRES_USER=blocktek_radio
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://blocktek_radio:replace-with-a-long-random-value@localhost:5432/blocktek_radio
REDIS_URL=redis://localhost:6379

# AI_PROVIDER may be "openai-compatible" or "development".
AI_PROVIDER=development
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Midnight remains visibly NOT CONFIGURED until a real SDK/toolchain is installed.
MIDNIGHT_NETWORK=unconfigured
MIDNIGHT_NODE_URL=
MIDNIGHT_INDEXER_URL=

# Live radio remains NOT_CONFIGURED until a real stream is configured and enabled.
RADIO_STREAM_URL=
RADIO_STREAM_NAME=Signal / Main
RADIO_STREAM_ENABLED=false

# Required before enabling authenticated/private production workflows.
AUTH_SECRET=replace-with-a-long-random-value
